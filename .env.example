# Copy to .env.local for local work. Never commit a real value: .env* files other than this one
# are ignored by git. In Vercel and CI, set these in the environment store instead
# (docs/operations/environments.md). Values are read only through the SecretsProvider port
# (K0-T14) and typed configuration at the composition root, never inside domain code.
#
# Forbidden here and anywhere in client code (ADR-0006):
# - no NEXT_PUBLIC_ or other client-exposed prefix on any of these;
# - no Supabase anon or service_role key for application queries (both bypass our tenancy model:
#   the browser never talks to Supabase, and service_role bypasses row-level security).

# local | preview | staging | production
GX_ENV=local

# ---------------------------------------------------------------- database (Supabase Postgres 17, Mumbai)
# Application role: our own non-owner role without BYPASSRLS (created by K1-T03), through the
# Supavisor pooler in TRANSACTION mode (port 6543). Every transaction sets app.tenant_id with SET LOCAL.
# Hosted form: postgresql://gx_app.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Local (supabase start): pooler on 54329.
DATABASE_URL=postgresql://gx_app:<password>@127.0.0.1:54329/postgres

# Migration role: owns the schema, used ONLY by the migration runner (K0-T05) in CI or by hand,
# never by the running app. Use the session pooler (5432) or the direct connection.
# Hosted form: postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Local (supabase start): direct database on 54322.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------- object storage (Supabase Storage, S3 protocol)
# Reached only through the BlobStore port (K8). Buckets are private.
# Hosted form: https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
STORAGE_S3_REGION=ap-south-1
STORAGE_S3_ACCESS_KEY_ID=<storage-access-key-id>
STORAGE_S3_SECRET_ACCESS_KEY=<storage-secret-access-key>
STORAGE_BUCKET=gx-files

# ---------------------------------------------------------------- mail (local sink; a provider later)
# Local Supabase mail sink web UI: http://127.0.0.1:54324
SMTP_URL=smtp://127.0.0.1:54325
