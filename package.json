{
  "name": "gx-foundation",
  "private": true,
  "description": "GX foundation kernel (packages/) with verticals in packs/. See docs/adr/0006-stack-hosting-and-repo-shape.md.",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:db": "GX_TEST_SUITE=db vitest run",
    "migrate": "node --conditions=@gx/source packages/migrate/src/bin/gx-migrate.ts",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:imports": "node --conditions=@gx/source packages/toolchain/src/bin/check-imports.ts",
    "api:update": "node --conditions=@gx/source packages/toolchain/src/bin/check-api.ts --update",
    "api:check": "node --conditions=@gx/source packages/toolchain/src/bin/check-api.ts",
    "check:manifests": "node --conditions=@gx/source packages/toolchain/src/bin/check-manifests.ts",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run check:imports && pnpm run check:manifests && pnpm run api:check && pnpm run migrate check && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
