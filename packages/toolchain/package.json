{
  "name": "@gx/toolchain",
  "version": "0.0.0",
  "private": true,
  "description": "Checks that keep the foundation honest and extractable: import graph, manifest validator, boundary lint and public-API diff.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@gx/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "gx-check-imports": "./dist/bin/check-imports.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@gx/core": "workspace:*",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
